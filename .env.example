# Anthropic API — required for query parsing and explanations (Phases 2, 5)
ANTHROPIC_API_KEY=sk-ant-...

# Qdrant — leave blank to use local file-based storage (recommended for personal use)
QDRANT_URL=
QDRANT_API_KEY=
# Local storage path used when QDRANT_URL is unset
QDRANT_LOCAL_PATH=.qdrant_data

# Collection name (default: listings)
QDRANT_COLLECTION=listings

# Embedding model (default: BAAI/bge-m3)
EMBED_MODEL=BAAI/bge-m3

# Top-K results to return
DEFAULT_TOP_K=10

# Recency decay lambda (0 = no decay, 0.1 = aggressive decay)
LAMBDA_RECENCY=0.05
# Length preference decay center and scale (episodes)
LENGTH_ORIGIN=12
LENGTH_SCALE=24
# Score fusion: "rrf" or "dbsf"
FUSION_METHOD=rrf
# Claude model for query parser & explainer
CLAUDE_MODEL=claude-sonnet-4-6
# Reranker model
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_N=20
