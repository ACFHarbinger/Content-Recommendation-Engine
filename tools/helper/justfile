# tools/helper — presentation.

set shell := ["bash", "-c"]

bold := '\033[1m'
cyan := '\033[0;36m'
reset := '\033[0m'

[private]
_print_header:
    @printf '{{bold}}{{cyan}}Recommendation-Engine{{reset}}\n'
    @printf 'Local-first hybrid semantic-lexical recommendation engine for media libraries\n\n'

# List every recipe across all sub-modules
help: _print_header
    @just --list --list-submodules
