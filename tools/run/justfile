# tools/run — the `recommend` CLI + evaluation scripts.

set shell := ["bash", "-c"]

# Run the recommend CLI (recommend = src.cli.cli:cli)
cli *args:
    uv run recommend {{args}}

# Ingest a dataset into the SQLite store
ingest *args:
    uv run recommend ingest {{args}}

# Query the engine with a free-form prompt
query *args:
    uv run recommend query {{args}}

# Evaluate retrieval quality (NDCG@K, P@5) — no LLM needed
evaluate *args:
    uv run python scripts/evaluate.py {{args}}

# Sweep fusion/decay hyperparameters
sweep *args:
    uv run python scripts/sweep.py {{args}}
